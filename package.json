{
  "name": "dsh-davinci-qing",
  "version": "1.0.4",
  "description": "让青青住进你的dsh —— 连接 DeepSeek Harness 与 DaVinci Resolve Studio 的全流程工作流自动化桥梁，从媒体池归档、时间线粗剪到节点树调色与视觉审片，让创作者把时间留给创作。",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "dsh-plugin",
    "deepseek",
    "dsh",
    "deepseek-harness",
    "cordis",
    "davinci-resolve",
    "mcp",
    "video-editing",
    "color-grading",
    "workflow-automation",
    "filmmaking",
    "post-production",
    "typescript",
    "python"
  ],
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dist/index.js": "./dist/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./cordis.yml": "./cordis.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./locale/*.yml": "./locale/*.yml",
    "./icon": "./icon.svg"
  },
  "files": [
    "dist",
    "lib",
    "locale",
    "src",
    "docs",
    "cordis.patch.yml",
    "cordis.yml",
    "SKILL.md",
    "README.md",
    "LICENSE",
    "icon.svg",
    "tsconfig.json",
    "requirements.txt",
    "check_env.py"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:check": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:python": "python -m compileall -q lib",
    "check:spec": "node scripts/check-spec.mjs",
    "check:manifest": "python scripts/check_manifest.py",
    "check:schema": "python scripts/check_schema.py",
    "check:env": "python lib/check_env.py",
    "bridge:list": "python lib/resolve_bridge.py --list",
    "bridge:health": "python lib/resolve_bridge.py --health",
    "test:python": "python -m pytest tests -q",
    "test:smoke": "python tests/smoke_all_tools.py",
    "test:shell": "node tests/verify_ts_shell.mjs",
    "schema": "python export_schema.py",
    "verify": "npm run check:spec && npm run check:manifest && npm run check:schema && npm run typecheck && npm run build && npm run check:python && npm run test:smoke",
    "prepack": "npm run build"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.6.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.2 <5.0.0",
    "@deepseek-ai/dsh-tools": ">=0.1.0 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
